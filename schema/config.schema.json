  "additionalProperties": false,
  "description": "Schema shared by ``video.json`` (project) and ``config.json`` (product).\n\nEvery key is optional; missing keys fall back to the defaults below. The\nJSON Schema exported from this model (``fromversionzero schema``) is the\ncontract between this generator and dataset repositories.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "title": {
      "default": "Product Evolution",
      "title": "Title",
      "type": "string"
    },
    "motto": {
      "default": "",
      "title": "Motto",
      "type": "string"
    },
    "x_metric": {
      "default": "date",
      "title": "X Metric",
      "type": "string"
    },
    "metrics": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metrics"
    },
    "y_scale": {
      "default": "auto",
      "enum": [
        "auto",
        "log",
        "linear"
      ],
      "title": "Y Scale",
      "type": "string"
    },
    "speculation_text": {
      "default": "What will the next generation be?",
      "title": "Speculation Text",
      "type": "string"
    },
    "labels": {
      "$ref": "#/$defs/Labels",
      "default": {
        "intro_kicker": "From Version Zero  /  Evolution dossier",
        "facts": "Insight",
        "speculation_kicker": "Open question  /  Future signal",
        "speculation_prompt": "Drop your prediction  ↓",
        "speculation_footer": "Imagine it  •  Argue it  •  Build it",
        "outro_kicker": "Evolution complete",
        "outro_question": "What should we trace next?",
        "outro_prompt": "Drop your pick in the comments  ↓"
      }
    },
    "fps": {
      "default": 30,
      "exclusiveMinimum": 0,
      "maximum": 240,
      "title": "Fps",
      "type": "integer"
    },
    "resolution": {
      "default": "1080p",
      "title": "Resolution",
      "type": "string"
    },
    "ssaa_factor": {
      "default": 2,
      "maximum": 4,
      "minimum": 1,
      "title": "Ssaa Factor",
      "type": "integer"
    },
    "downsample_filter": {
      "default": "bicubic",
      "enum": [
        "bicubic",
        "lanczos",
        "bilinear",
        "nearest"
      ],
      "title": "Downsample Filter",
      "type": "string"
    },
    "image_transition": {
      "default": "fade",
      "enum": [
        "fade",
        "small_to_big_to_medium",
        "none"
      ],
      "title": "Image Transition",
      "type": "string"
    },
    "encoding": {
      "$ref": "#/$defs/EncodingSettings",
      "default": {
        "codec": "h264",
        "crf": 18,
        "preset": "medium"
      }
    },
    "theme": {
      "default": "signal",
      "title": "Theme",
      "type": "string"
    },
    "colors": {
      "$ref": "#/$defs/ColorOverrides",
      "default": {
        "background": null,
        "grid": null,
        "grid_dots": null,
        "line": null,
        "line_glow": null,
        "text_primary": null,
        "text_secondary": null,
        "accent": null,
        "accent_glow": null,
        "line_colors": null
      }
    },
    "fonts": {
      "$ref": "#/$defs/FontOverrides",
      "default": {
        "display": null,
        "heading": null,
        "body": null,
        "label": null
      }
    },
    "intro_duration": {
      "default": 3.0,
      "minimum": 0,
      "title": "Intro Duration",
      "type": "number"
    },
    "reveal_duration": {
      "default": 4.0,
      "exclusiveMinimum": 0,
      "title": "Reveal Duration",
      "type": "number"
    },
    "steady_duration": {
      "default": 2.0,
      "minimum": 0,
      "title": "Steady Duration",
      "type": "number"
    },
    "hold_duration": {
      "default": 5.0,
      "minimum": 0,
      "title": "Hold Duration",
      "type": "number"
    },
    "outro_duration": {
      "default": 3.0,
      "minimum": 0,
      "title": "Outro Duration",
      "type": "number"
    },
    "speculation_duration": {
      "default": 9.0,
      "minimum": 0,
      "title": "Speculation Duration",
      "type": "number"
    },
    "fact_card_duration": {
      "default": 4.0,
      "minimum": 0,
      "title": "Fact Card Duration",
      "type": "number"
    },
    "camera": {
      "$ref": "#/$defs/CameraSettings",
      "default": {
        "speed": 2.5
      }
    },
    "shorts_overrides": {
      "$ref": "#/$defs/ShortsOverrides",
      "default": {
        "intro_duration": 0.0,
        "outro_duration": 0.0,
        "reveal_duration": 2.0,
        "steady_duration": 1.0,
        "hold_duration": 3.0,
        "speculation_duration": 5.0,
        "resolution": "1080x1920"
      }
    },
    "media": {
      "$ref": "#/$defs/MediaSettings",
      "default": {
        "logo": null,
        "logo_levels": 3,
        "logo_invert": false,
        "image_levels": 2,
        "image_invert": false,
        "stylize": true
      }
    },
    "music": {
      "$ref": "#/$defs/MusicSettings",
      "default": {
        "file": "soundtrack.mp3",
        "volume": 0.7,
        "fade_in": 2.0,
        "fade_out": 3.0
      }
    },
    "mix_sfx": {
      "default": true,
      "title": "Mix Sfx",
      "type": "boolean"
    },
    "product_name": {
      "default": "",
      "title": "Product Name",
      "type": "string"
    },
    "output_folder": {
      "default": "",
      "title": "Output Folder",
      "type": "string"
    },
    "shorts": {
      "default": false,
      "title": "Shorts",
      "type": "boolean"
    },
    "speculation": {
      "default": true,
      "title": "Speculation",
      "type": "boolean"
    },
    "show_motto": {
      "default": true,
      "title": "Show Motto",
      "type": "boolean"
    },
    "show_logo": {
      "default": true,
      "title": "Show Logo",
      "type": "boolean"
    },
    "show_legend": {
      "default": true,
      "title": "Show Legend",
      "type": "boolean"
    },
    "show_facts": {
      "default": true,
      "title": "Show Facts",
      "type": "boolean"
    },
    "show_progress_bar": {
      "default": true,
      "title": "Show Progress Bar",
      "type": "boolean"
    }
